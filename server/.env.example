# ========================================================
# SCHOLARMESH AI - SERVER (RENDER & SUPABASE ENVIRONMENT)
# ========================================================
PORT=5000
NODE_ENV=development

# Render External URL (Set automatically by Render in production)
RENDER_EXTERNAL_URL=https://scholarmesh-api.onrender.com

# Supabase Project Connection Details
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Supabase PostgreSQL Pooler Connection URI (Port 6543 for transaction pooler or 5432 for session)
# From Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Security & AI Keys
JWT_SECRET=scholarmesh_ultra_secure_jwt_secret_key_2026_scholar_mesh
GEMINI_API_KEY=your_google_gemini_api_key_here

# Client URL (Allowed CORS Origin)
CLIENT_URL=http://localhost:5173
