# ========================================================
# SCHOLARMESH AI - BACKEND SUPABASE & RENDER ENVIRONMENT
# ========================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (For client-safe requests & public auth)
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Supabase Service Role Key (SUPERUSER PRIVILEGES - Never expose to frontend!)
# Used for backend database administration, bypassing RLS when indexing, and storage bucket management
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct Connection)
# From Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Render Deployment URL
RENDER_EXTERNAL_URL=https://scholarmesh-api.onrender.com
PORT=5000
NODE_ENV=development

